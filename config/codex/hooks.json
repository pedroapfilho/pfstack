{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-memory.sh codex",
            "timeout": 10,
            "additionalContextLimit": 4000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
